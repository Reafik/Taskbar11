{
  "name": "design-context-pro",
  "version": "1.0.0",
  "description": "Figma plugin and web app for adding context to design systems",
  "private": true,
  "workspaces": [
    "figma-plugin",
    "web-app/client",
    "web-app/server"
  ],
  "scripts": {
    "install:all": "npm install && cd figma-plugin && npm install && cd ../web-app/client && npm install && cd ../server && npm install",
    "build:plugin": "cd figma-plugin && npm run build",
    "build:client": "cd web-app/client && npm run build",
    "build:server": "cd web-app/server && npm run build",
    "build:all": "npm run build:plugin && npm run build:client && npm run build:server",
    "dev:plugin": "cd figma-plugin && npm run dev",
    "dev:client": "cd web-app/client && npm run dev",
    "dev:server": "cd web-app/server && npm run dev",
    "start:server": "cd web-app/server && npm start"
  },
  "keywords": [
    "figma",
    "plugin",
    "design-system",
    "documentation",
    "design-ops"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/design-context-pro.git"
  }
}
